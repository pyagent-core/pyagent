# ── LLM providers (required by all recipes) ─────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=AIza...

# ── AML Monitoring + Incident Triage (HITL compliance gate) ─────────────────
COMPLIANCE_API_URL=https://compliance.example.com
COMPLIANCE_API_KEY=your-compliance-api-key

# ── Incident Triage (PagerDuty on-call approval) ────────────────────────────
PAGERDUTY_ROUTING_KEY=your-pagerduty-routing-key
PAGERDUTY_API_KEY=your-pagerduty-api-key

# ── Support Router (Zendesk ticket creation) ─────────────────────────────────
ZENDESK_URL=https://yourcompany.zendesk.com
ZENDESK_EMAIL=agent@yourcompany.com
ZENDESK_TOKEN=your-zendesk-api-token

# ── Code Review (human security review queue) ───────────────────────────────
REVIEW_QUEUE_URL=https://reviews.example.com
REVIEW_QUEUE_TOKEN=your-review-queue-token

# ── ESG Analyzer (external data feeds) ───────────────────────────────────────
ESG_DATA_API_URL=https://esg-data.example.com
ESG_DATA_API_KEY=your-esg-api-key

# ── Loan Origination (LOS + credit bureau) ──────────────────────────────────
LOS_API_URL=https://los.example.com
LOS_API_KEY=your-los-api-key
CREDIT_BUREAU_URL=https://credit.example.com
CREDIT_BUREAU_KEY=your-credit-bureau-key

# ── Slack notifications (optional, any recipe) ──────────────────────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
